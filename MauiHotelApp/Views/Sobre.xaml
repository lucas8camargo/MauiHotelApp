<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiHotelApp.Views.Sobre"
             Title="Sobre o App"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="25">

            <!-- Cabeçalho -->
            <Frame
                BackgroundColor="#2563EB"
                CornerRadius="20"
                Padding="25"
                HasShadow="True">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="📱"
                        FontSize="50"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Informações do Aplicativo"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Projeto Acadêmico"
                        FontSize="14"
                        TextColor="#DCE7FF"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Card Principal -->
            <Frame
                BackgroundColor="White"
                CornerRadius="20"
                Padding="25"
                HasShadow="True">

                <VerticalStackLayout Spacing="20">

                    <!-- Atividade -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="📚 Atividade"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="#2563EB"/>

                        <Label
                            Text="Desenvolvimento de Sistemas II - Agenda 13"
                            FontSize="18"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E7EB"/>

                    <!-- Desenvolvedor -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="👨‍💻 Desenvolvedor"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="#2563EB"/>

                        <Label
                            Text="Lucas Camargo"
                            FontSize="18"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#E5E7EB"/>

                    <!-- Ano -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="📅 Ano de Desenvolvimento"
                            FontAttributes="Bold"
                            FontSize="16"
                            TextColor="#2563EB"/>

                        <Label
                            Text="2026"
                            FontSize="18"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Rodapé -->
            <Label
                Text="Versão 1.0"
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"/>

            <Button
                Text="Voltar"
                Margin="0,5,0,20"
                HeightRequest="50"
                CornerRadius="15"
                BorderColor="{StaticResource Primary}"
                BorderWidth="2"
                BackgroundColor="White"
                TextColor="{StaticResource Primary}"
                Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>